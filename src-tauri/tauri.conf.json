{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "todo-overlay-app",
  "version": "0.1.0",
  "identifier": "com.todooverlay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Todo Studio",
        "label": "main",
        "width": 1000,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "title": "Todo Sticky Widget",
        "label": "widget",
        "width": 380,
        "height": 320,
        "minWidth": 240,
        "minHeight": 140,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
